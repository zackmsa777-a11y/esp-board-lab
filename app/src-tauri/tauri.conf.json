{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESP Board Lab",
  "version": "0.1.0",
  "identifier": "dev.espboardlab.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "ESP Board Lab",
      "width": 1280,
      "height": 800,
      "minWidth": 800,
      "minHeight": 600,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "ESP32 firmware emulator workbench",
    "category": "DeveloperTool"
  }
}
